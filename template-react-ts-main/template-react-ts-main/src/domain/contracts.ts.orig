/** ISO-8601 timestamp serialized as a string at service boundaries. */
export type IsoTimestamp = string;

/** Normalized numeric values are inclusive and constrained to [0, 1]. */
export type NormalizedScore = number;

export type CourseDataSourceKind = "waterloo-mcp" | "local" | "synthetic";

export interface CourseDataSource {
  kind: CourseDataSourceKind;
  label: string;
  lastSyncedAt: IsoTimestamp | null;
}

export interface CourseSummary {
  id: string;
  code?: string;
  title: string;
  term?: string;
  dataSource: CourseDataSource;
}

export type LearningMaterialOrigin = "synthetic" | "local";

export interface LearningMaterialProvenance {
  origin: LearningMaterialOrigin;
  sourceId?: string;
  generatedAt?: IsoTimestamp;
}

export interface LocalLearningMaterial {
  id: string;
  courseId: string;
  title: string;
  /** Synthetic/local input only; never send externally by default. Handle locally. */
  contentText: string;
  fingerprint: string;
  provenance: LearningMaterialProvenance;
  createdAt: IsoTimestamp;
  updatedAt: IsoTimestamp;
}

export interface IdentifiedLearningObjective {
  id: string;
  materialId: string;
  courseId: string;
  statement: string;
  confidence: NormalizedScore;
  conceptTerms?: string[];
  order?: number;
}

export interface MultipleChoiceChoice {
  id: string;
  label: string;
}

/** Question payloads are intended for local, synthetic study content only. */
export interface MultipleChoiceQuestion {
  id: string;
  objectiveId: string;
  prompt: string;
  choices: MultipleChoiceChoice[];
  correctChoiceId: string;
  explanation: string;
}

export interface SubmittedAnswer {
  questionId: string;
  choiceId: string;
  submittedAt: IsoTimestamp;
}

export interface AnswerResult {
  questionId: string;
  submittedChoiceId: string;
  correctChoiceId: string;
  isCorrect: boolean;
  explanation: string;
  evaluatedAt: IsoTimestamp;
}

export interface MasteryState {
  objectiveId: string;
  normalizedScore: NormalizedScore;
  attempts: number;
  correctCount: number;
  lastAttemptAt: IsoTimestamp | null;
  nextReviewAt: IsoTimestamp | null;
}

export interface StudyRecommendation {
  objectiveId: string;
  normalizedPriority: NormalizedScore;
  rationale: string;
  dueAt: IsoTimestamp | null;
}

export type ConnectorSyncState =
  | "not-configured"
  | "checking"
  | "connected"
  | "reauth-required"
  | "offline";

export interface ConnectorSyncStatus {
  state: ConnectorSyncState;
  updatedAt: IsoTimestamp;
  lastSuccessAt: IsoTimestamp | null;
  message?: string;
}

export interface CourseSyncService {
  getStatus(): Promise<ConnectorSyncStatus>;
  syncCourses(): Promise<CourseSummary[]>;
}

export interface StudyProgressPersistence {
  loadMastery(objectiveId: string): Promise<MasteryState | null>;
  saveAnswer(
    answer: SubmittedAnswer,
    result: AnswerResult,
    mastery: MasteryState,
  ): Promise<void>;
}
